# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used solely to create accounts from the Admin page. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# 0 = weeks start Sunday (default), 1 = Monday
NEXT_PUBLIC_WEEK_STARTS_ON=0
# Decides what "today" and "this week" mean
NEXT_PUBLIC_TIMEZONE=America/New_York
